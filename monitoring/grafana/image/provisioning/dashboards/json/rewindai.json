  "panels": [
    {
      "type": "stat",
      "title": "Live version",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rewind_live_info{app=\"$app\"}",
