          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU %",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rewind_container_cpu_percent{app=\"$app\"}",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory %",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rewind_container_memory_percent{app=\"$app\"}",
          "legendFormat": "memory",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Probe p95 (s)",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(rewind_probe_seconds_bucket{app=\"$app\"}[1m])))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Anomaly score",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "rewind_anomaly_score{app=\"$app\"}",
          "legendFormat": "score",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Status (1 healthy / 2 anomaly / 3 rolled back)",
